# Claude API Tool Calling 데모 환경 설정

# 필수: Anthropic API 키
# https://console.anthropic.com/ 에서 발급받을 수 있습니다.
ANTHROPIC_API_KEY=your-api-key-here

# 선택: 사용할 Claude 모델 (기본값: claude-sonnet-4-6)
# ANTHROPIC_MODEL=claude-sonnet-4-6

# DeepSeek API 키 (LLM + Embedding + RAG 통합 시나리오용)
# https://platform.deepseek.com/api_keys 에서 발급받을 수 있습니다.
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Ollama 서버 설정 (OllamaEmbedder용)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBED_MODEL=mxbai-embed-large:335m
